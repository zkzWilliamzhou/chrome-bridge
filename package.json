{
  "name": "chrome-bridge",
  "version": "0.1.0",
  "description": "Universal API adapter for cross-browser extensions. Write once, deploy everywhere.",
  "keywords": ["browser-extension", "cross-browser", "api-adapter", "manifest-v3"],
  "author": "ChromeBridge Contributors",
  "license": "MIT",
  "bin": { "chrome-bridge": "./dist/index.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "package": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.4.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "eslint": "^8.57.0"
  },
  "engines": { "node": ">=18.0.0" },
  "repository": { "type": "git", "url": "https://github.com/yourname/chrome-bridge.git" },
  "bugs": { "url": "https://github.com/yourname/chrome-bridge/issues" }
}